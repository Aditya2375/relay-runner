[6.581824, "o", "\r\n$ node bin/relay.js init --home ./sandbox\r\n"]
[6.622802, "o", "Initialized /tmp/relay-record/relay-runner/sandbox/.relay (existing key preserved)\r\n"]
[8.028112, "o", "\r\n$ node bin/relay.js issue system.summary --home ./sandbox --out ./sandbox/summary.json\r\n"]
[8.074385, "o", "Signed system.summary -> ./sandbox/summary.json\r\n"]
[9.480146, "o", "\r\n$ node bin/relay.js run ./sandbox/summary.json --home ./sandbox\r\n"]
[9.520001, "o", "{\r\n  \"host\": \"e2b.local\",\r\n  \"platform\": \"linux\",\r\n  \"arch\": \"x64\",\r\n  \"release\": \"6.1.158+\",\r\n  \"node\": \"v22.23.2\"\r\n}\r\n"]
[10.926204, "o", "\r\n$ node bin/relay.js help\r\n"]
[10.965407, "o", "Relay Runner · local signed tasks\r\n\r\n  npm run demo                 private, zero-network loop\r\n  node bin/relay.js init --home DIR\r\n  node bin/relay.js issue TASK --home DIR [--text NOTE] [--out FILE]\r\n  node bin/relay.js run FILE --home DIR [--workspace DIR] [--enable-commands]\r\n\r\nTasks: system.summary, workspace.list, notes.append, command.node-version\r\nThe signing key is in DIR/.relay/secret. Keep it private. No network listener.\r\n"]
